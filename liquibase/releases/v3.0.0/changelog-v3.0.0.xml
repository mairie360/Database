            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <!-- Former releases/v1.12.0: event dates bounded to [1970-01-01, 3000-01-01) UTC (MAIR-481). -->
    <changeSet id="rel-1.12.0-01" author="dev"
        logicalFilePath="releases/v1.12.0/changelog-v1.12.0.xml"
    ><sqlFile
            path="06__events_date_window.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback><sqlFile
            path="06__events_date_window.rollback.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <changeSet id="tag-v3.0.0" author="dev"><tagDatabase tag="v3.0.0"/></changeSet>

</databaseChangeLog>
