<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd"
    logicalFilePath="releases"
>

    <!-- Changesets shipped by the git tag v4.0.0. Their identity does not depend on the
         folder: renaming it after the release keeps them applied. -->

    <!-- Core is the only account system: the Keycloak SSO objects are dropped (MAIR-812). -->
    <changeSet id="mair-812-01" author="dev"><sqlFile
            path="01__remove_keycloak.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback><sqlFile
            path="01__remove_keycloak.rollback.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <!-- Messaging V2 (MAIR-1155, epic MAIR-821): reactions, system notes of the membership changes,
         mentions of everyone and of groups. -->
    <changeSet id="mair-1155-01" author="dev"><sqlFile
            path="02__message_reactions.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback><sqlFile
            path="02__message_reactions.rollback.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <changeSet id="mair-1155-02" author="dev"><sqlFile
            path="03__messages_system_notes.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback><sqlFile
            path="03__messages_system_notes.rollback.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <changeSet id="mair-1155-03" author="dev"><sqlFile
            path="04__message_mentions_everyone_and_groups.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback><sqlFile
            path="04__message_mentions_everyone_and_groups.rollback.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <changeSet id="tag-v4.0.0" author="dev"><tagDatabase tag="v4.0.0"/></changeSet>

</databaseChangeLog>
