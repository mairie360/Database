<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd"
    logicalFilePath="releases"
>

    <!-- Changesets shipped by the git tag v3.11.1. Their identity does not depend on the
         folder: renaming it after the release keeps them applied. -->

    <!-- The author of a project template is not a foreign key (MAIR-691). -->
    <changeSet id="mair-691-02" author="dev"><sqlFile
            path="01__project_template_author_no_fk.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback><sqlFile
            path="01__project_template_author_no_fk.rollback.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <changeSet id="tag-v3.11.1" author="dev"><tagDatabase tag="v3.11.1"/></changeSet>

</databaseChangeLog>
