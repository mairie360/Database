<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd"
    logicalFilePath="releases"
>

    <!-- Changesets shipped by the git tag v4.1.0. Their identity does not depend on the
         folder: renaming it after the release keeps them applied. -->

    <!-- Settings V2: auto-save, system updates and login alerts preferences (MAIR-823). -->
    <changeSet id="mair-823-01" author="dev"><sqlFile
            path="01__settings_v2_columns.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback><sqlFile
            path="01__settings_v2_columns.rollback.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <changeSet id="tag-v4.1.0" author="dev"><tagDatabase tag="v4.1.0"/></changeSet>

</databaseChangeLog>
