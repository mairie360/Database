<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd"
    logicalFilePath="releases"
>

    <!-- Changesets shipped by the git tag v4.1.0. Their identity does not depend on the
         folder: renaming it after the release keeps them applied. -->

    <!-- Trigram indexes of the global search of the business APIs (GET /v1/search). -->
    <changeSet id="mair-1228-01" author="dev"><sqlFile
            path="01__global_search_trigram.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback><sqlFile
            path="01__global_search_trigram.rollback.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <!-- Function (job title) of an agent, on the Profile tab of Settings. -->
    <changeSet id="mair-1231-01" author="dev"><sqlFile
            path="02__users_job_title.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback><sqlFile
            path="02__users_job_title.rollback.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /></rollback></changeSet>

    <changeSet id="tag-v4.1.0" author="dev"><tagDatabase tag="v4.1.0"/></changeSet>

</databaseChangeLog>
