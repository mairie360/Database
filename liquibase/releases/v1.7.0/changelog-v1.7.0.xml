<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd"
>

    <!-- From v1.7.0 on, every release changeset carries its <rollback> and the
         release ends with a tagDatabase changeset, so that
         `liquibase rollback v1.7.0` undoes the changesets applied after it. -->

    <changeSet id="rel-1.7.0-01" author="dev"><sqlFile
            path="01__users_email_case_insensitive.sql"
            splitStatements="false"
            relativeToChangelogFile="true"
        /><rollback>DROP INDEX IF EXISTS uq_users_email_lower;</rollback></changeSet>

    <changeSet id="rel-1.7.0-tag" author="dev"><tagDatabase tag="v1.7.0"/></changeSet>

</databaseChangeLog>
