    <!-- Changesets shipped by the git tag v2.0.0. They were written in
         releases/<schema version>/ folders that did not match the git tags; each
         keeps its id and its former changelog path as logicalFilePath, the
         identity Liquibase stored in databasechangelog: never change either. -->

    <!-- Former releases/v1.3.0: argon2id password hashes required, NOT VALID (MAIR-169). -->
    <changeSet id="rel-1.3.0-01" author="dev"
        logicalFilePath="releases/v1.3.0/changelog-v1.3.0.xml"
