    <!-- Added after v2.0.0 shipped. A database that already applied the next
         tag would get this tag after it, so it is only set while rel-1.9.0-01 has
         not run. CONTINUE, not MARK_RAN: MARK_RAN still writes the tag. Such a
         database re-checks and skips it on every update. -->
    <changeSet id="tag-v2.0.0" author="dev">
        <preConditions onFail="CONTINUE">
            <sqlCheck expectedResult="0">SELECT count(*) FROM databasechangelog WHERE id = 'rel-1.9.0-01'</sqlCheck>
        </preConditions>
        <tagDatabase tag="v2.0.0"/>
    </changeSet>

</databaseChangeLog>
